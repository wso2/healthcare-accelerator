# iam-service-extensions Configuration Template
# Copy to Config.toml and fill in your values.

hostname = "localhost"
port = 9093

# EHR launch context resolution (optional — leave blank to skip)
ehrContextResolveUrl = ""

# Management application credentials: used for the consent management API (internal_consent_mgt_consent_view)
# and SCIM user lookup (internal_user_mgt_view). Authorize the app for both APIs.
# WSO2 IS 7.3.0+ base URL — also hosts the consent management API
isBaseUrl = "https://localhost:9443"
# Consent management API path (use /t/<tenant-domain>/api/identity/consent-mgt/v2.0 for tenants)
consentApiPath = "/api/identity/consent-mgt/v2.0"
scimApiPath = "/scim2/Users"
scimClientId = "<scim-client-id>"
scimClientSecret = "<scim-client-secret>"
# Leave empty to default to {isBaseUrl}/oauth2/token
scimTokenEndpoint = ""
scimPatientGroupName = "patient"
fhirUserAttributeName = "fhirUser"

# Trust store for HTTPS connections to IDP/SCIM/EHR endpoints (optional)
trustStorePath = ""
trustStorePassword = ""

# Scopes that bypass consent checks (always included in the token)
# Must match serviceId of consent-app-bff
consentServiceId = "smart-on-fhir"

alwaysAllowedScopes = ["openid"]
