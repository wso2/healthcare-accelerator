# consent-app-bff Configuration Template
# Copy to Config.toml and fill in your values.

hostname = "localhost"
port = 9092
corsAllowedOrigin = "http://localhost:5176"

# IDP base URL — works for both WSO2 IS and Asgardeo
# WSO2 IS example:   "https://localhost:9443"
# Asgardeo example:  "https://api.asgardeo.io/t/mytenant"
idpBaseUrl = "https://localhost:9443"

# Leave empty to default to {idpBaseUrl}/oauth2/token
idpTokenEndpoint = ""

clientId = "<oauth2-client-id>"
clientSecret = "<oauth2-client-secret>"   # also used as JWT signing secret

# Consent flow:
#   "scope"   — all apps use SMART scope flow
#   "purpose" — all apps use purpose+element flow
#   "auto"    — determine flow per client_id using scopeConsentedApps / purposeConsentedApps below
consentFlow = "scope"

# Only used when consentFlow = "auto"
# List the spId values that should use the scope flow
scopeConsentedApps = ["<spId-1>", "<spId-2>"]
# List the spId values that should use the purpose flow
purposeConsentedApps = ["<spId-3>"]
# Fallback URL for client_ids not in either list — sessionDataKeyConsent and spId are appended
defaultIdpConsentPage = "https://localhost:9443/authenticationendpoint/oauth2_consent.do"

# Consent management API of WSO2 IS 7.3.0+ (reached via idpBaseUrl using the management app above).
# The management app must be authorized for the Consent Management API with scopes:
#   internal_consent_mgt_purpose_view, internal_consent_mgt_element_view,
#   internal_consent_mgt_consent_create, internal_consent_mgt_consent_view, internal_consent_mgt_consent_update
# For a non carbon.super tenant use "/t/<tenant-domain>/api/identity/consent-mgt/v2.0"
# consentApiBasePath = "/api/identity/consent-mgt/v2.0"

# Service ID recorded on every consent created by this service
serviceId = "smart-on-fhir"

alwaysAllowedScopes = ["openid"]

singleConsentPerUser = false
showConsentElements = true

# Validity duration for scope consents recorded in WSO2 IS, in seconds (default: 3 hours)
# scopeConsentValidityTime = 10800

# Scope flow: which WSO2 IS consent purpose wraps SMART scopes (its elements are fetched from WSO2 IS at startup).
# The purpose must be created in WSO2 IS beforehand; the approved scopes themselves are stored as consent properties.
[scopeConsent]
purposeName = "SMART Scope Authorization"

# Purpose flow: one [[purposeConsent]] entry per purpose shown in the consent UI.
# description, mandatory flag, and elements are fetched from WSO2 IS at startup.
# The service fails to start if any listed purpose is not found in WSO2 IS.
[[purposeConsent]]
purposeName = "All Health Data Access"
